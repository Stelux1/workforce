{
  "name": "Document",
  "type": "object",
  "properties": {
    "employee_id": {
      "type": "string",
      "description": "Reference to employee record ID"
    },
    "title": {
      "type": "string",
      "description": "Document title"
    },
    "category": {
      "type": "string",
      "enum": [
        "id_card",
        "passport",
        "work_permit",
        "contract",
        "certificate",
        "diploma",
        "training_certificate",
        "driver_license",
        "insurance",
        "medical_certificate",
        "safety_certificate",
        "other"
      ],
      "description": "Document category"
    },
    "file_url": {
      "type": "string",
      "description": "File URL"
    },
    "file_name": {
      "type": "string",
      "description": "Original file name"
    },
    "expiration_date": {
      "type": "string",
      "format": "date",
      "description": "Expiration date"
    },
    "status": {
      "type": "string",
      "enum": [
        "valid",
        "expiring_soon",
        "expired"
      ],
      "default": "valid",
      "description": "Document status"
    },
    "notes": {
      "type": "string",
      "description": "Notes"
    }
  },
  "required": [
    "employee_id",
    "title",
    "category"
  ]
}