{
  "name": "Rate",
  "type": "object",
  "properties": {
    "scope": {
      "type": "string",
      "enum": [
        "assignment",
        "project",
        "employee"
      ],
      "default": "project",
      "description": "Specificity level: assignment (highest) > project/role > employee default"
    },
    "kind": {
      "type": "string",
      "enum": [
        "cost",
        "revenue"
      ],
      "description": "cost = payable to worker/vendor, revenue = billable to client"
    },
    "unit": {
      "type": "string",
      "enum": [
        "hourly",
        "daily",
        "weekly",
        "monthly"
      ],
      "default": "hourly"
    },
    "amount": {
      "type": "number",
      "description": "Rate amount per unit"
    },
    "currency": {
      "type": "string",
      "enum": [
        "EUR",
        "RSD",
        "GBP",
        "USD"
      ],
      "default": "EUR"
    },
    "employee_id": {
      "type": "string"
    },
    "employee_name": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "project_name": {
      "type": "string"
    },
    "position": {
      "type": "string",
      "description": "Role the rate applies to (project scope only)"
    },
    "assignment_id": {
      "type": "string",
      "description": "ProjectAssignment ID for assignment scope"
    },
    "effective_from": {
      "type": "string",
      "format": "date"
    },
    "effective_to": {
      "type": "string",
      "format": "date",
      "description": "Empty = open ended"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "kind",
    "unit",
    "amount",
    "effective_from"
  ]
}