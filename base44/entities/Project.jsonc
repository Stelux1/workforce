{
  "name": "Project",
  "type": "object",
  "properties": {
    "project_number": {
      "type": "string",
      "description": "Broj projekta"
    },
    "name": {
      "type": "string",
      "description": "Naziv projekta"
    },
    "client_name": {
      "type": "string",
      "description": "Klijent"
    },
    "location": {
      "type": "string",
      "description": "Lokacija"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "Datum po\u010detka"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "Rok zavr\u0161etka"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "paused",
        "completed"
      ],
      "default": "active",
      "description": "Status projekta"
    },
    "description": {
      "type": "string",
      "description": "Opis radova"
    },
    "job_roles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "b2c_rate": {
            "type": "number",
            "description": "Tarifa prema radniku (\u20ac/h)"
          },
          "b2b_rate": {
            "type": "number",
            "description": "Tarifa prema klijentu (\u20ac/h)"
          }
        }
      },
      "description": "Tipovi zanimanja i tarife na projektu"
    },
    "assigned_employees": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "employee_id": {
            "type": "string"
          },
          "employee_name": {
            "type": "string"
          },
          "position": {
            "type": "string"
          },
          "b2c_rate": {
            "type": "number"
          },
          "b2b_rate": {
            "type": "number"
          }
        }
      },
      "description": "Zaposleni na projektu"
    }
  },
  "required": [
    "name"
  ]
}