{
  "name": "DepartmentConfig",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Department name"
    },
    "translation": {
      "type": "string",
      "description": "Department name translation (Serbian)"
    },
    "positions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Position name (English)"
          },
          "translation": {
            "type": "string",
            "description": "Position name translation (Serbian)"
          }
        }
      },
      "description": "List of positions in this department with translations"
    },
    "color": {
      "type": "string",
      "description": "Optional color tag"
    }
  },
  "required": [
    "name"
  ]
}