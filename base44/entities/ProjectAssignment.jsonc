{
  "name": "ProjectAssignment",
  "type": "object",
  "properties": {
    "employee_id": {
      "type": "string"
    },
    "employee_name": {
      "type": "string",
      "description": "Snapshot of the employee name"
    },
    "project_id": {
      "type": "string"
    },
    "project_name": {
      "type": "string",
      "description": "Snapshot of the project name"
    },
    "position": {
      "type": "string",
      "description": "Role on this project"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "planned",
        "active",
        "completed",
        "cancelled"
      ],
      "default": "active"
    },
    "affiliation_id": {
      "type": "string",
      "description": "EmploymentHistory record applicable at start_date"
    },
    "vendor_id": {
      "type": "string",
      "description": "Vendor applicable at start_date (from affiliation)"
    },
    "vendor_name": {
      "type": "string"
    },
    "engagement_type": {
      "type": "string",
      "enum": [
        "direct_employee",
        "subcontractor_worker"
      ]
    },
    "rate_reference": {
      "type": "string",
      "description": "Contract / rate agreement reference"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "employee_id",
    "project_id",
    "start_date"
  ]
}