{
  "name": "Position",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Position title"
    },
    "category": {
      "type": "string",
      "enum": [
        "technical",
        "management",
        "sales",
        "support",
        "operations",
        "other"
      ],
      "description": "Position category"
    },
    "description": {
      "type": "string",
      "description": "Position description"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Is position available"
    }
  },
  "required": [
    "title"
  ]
}